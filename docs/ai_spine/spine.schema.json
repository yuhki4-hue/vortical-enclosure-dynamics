{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VED AI Spine",
  "type": "object",
  "required": ["spine_version", "purpose", "layer_policy", "layer0", "layer1"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "spine_version": { "type": "string" },
    "purpose": { "type": "string" },
    "layer_policy": {
      "type": "object",
      "required": ["machine_validated", "not_enforced", "absent"],
      "additionalProperties": false,
      "properties": {
        "machine_validated": { "const": [0, 1] },
        "not_enforced": { "const": [2] },
        "absent": { "const": [3] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "advisory_links": {
      "type": "array",
      "description": "Layer 2 references. Advisory only — never existence-checked or enforced.",
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "layer0": {
      "type": "object",
      "required": ["repository_name", "framework_name", "abbreviation", "calibration_paths"],
      "additionalProperties": false,
      "properties": {
        "repository_name": { "type": "string" },
        "framework_name": { "type": "string" },
        "abbreviation": { "type": "string" },
        "calibration_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "role"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "generated_outputs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "layer1": {
      "type": "object",
      "required": ["sequence_semantics", "canonical_derivation_order", "relation_role_inventory"],
      "additionalProperties": false,
      "properties": {
        "sequence_semantics": {
          "type": "object",
          "required": ["legacy_field_name", "interpreted_as", "uniform_arrow_semantics",
                       "status_semantics", "application_inference",
                       "canonical_role_table", "not_equivalent_to", "open_bridge_candidates"],
          "additionalProperties": false,
          "properties": {
            "legacy_field_name": { "const": "canonical_derivation_order" },
            "interpreted_as": { "const": "navigation_order" },
            "uniform_arrow_semantics": { "const": false },
            "status_semantics": { "const": "source_local_documentary_role_only" },
            "application_inference": { "const": "not_implied" },
            "canonical_role_table": { "type": "string" },
            "not_equivalent_to": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "open_bridge_candidates": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "canonical_derivation_order": {
          "type": "array",
          "description": "Legacy-compatible field name for ranked navigation metadata; ranks do not encode proof or physical generation.",
          "items": {
            "type": "object",
            "required": ["rank", "id", "label", "kind", "derivation_role", "status"],
            "additionalProperties": false,
            "properties": {
              "rank": { "type": "integer", "minimum": 0 },
              "id": { "type": "string" },
              "label": { "type": "string" },
              "kind": {
                "type": "string",
                "enum": ["axiom", "variable", "relation", "process",
                         "recursive_process", "regime", "boundary_condition"]
              },
              "derivation_role": {
                "type": "string",
                "enum": ["origin", "source_local_first_carrier",
                         "represented_field_stage", "effective_relation_stage",
                         "derived_construction_stage", "candidate_mechanism_stage",
                         "constitutive_limit"]
              },
              "status": { "type": "string", "enum": ["confirmed", "proposed"] }
            }
          }
        },
        "boundary_terms": {
          "type": "array",
          "description": "Off-backbone terms referenced by relations. They carry a kind but no rank.",
          "items": {
            "type": "object",
            "required": ["id", "label", "kind", "status"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "kind": { "type": "string", "enum": ["structure", "field"] },
              "status": { "type": "string", "enum": ["confirmed", "proposed"] }
            }
          }
        },
        "validated_relations": {
          "type": "array",
          "description": "Non-generative source-local or proposed correspondences. They never create a proof or generation rank.",
          "items": {
            "type": "object",
            "required": ["from", "to", "relation", "generative", "status"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "relation": {
                "type": "string",
                "enum": ["accumulation_structure", "structural_extension_of",
                         "proposed_correspondence"]
              },
              "generative": { "type": "boolean", "const": false },
              "status": { "type": "string", "enum": ["confirmed", "proposed"] },
              "note": { "type": "string" }
            }
          }
        },
        "relation_role_inventory": {
          "type": "array",
          "description": "Documentation metadata mirroring the canonical human-readable relation-role table. It is not an arrow calculus.",
          "items": {
            "type": "object",
            "required": ["id", "from", "to", "role_classes", "bridge_status",
                         "physical_status", "note"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^N[0-9]{2}$" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "role_classes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["source_local_navigation", "formal_construction",
                           "effective_relation", "open_bridge",
                           "candidate_physical_interpretation"]
                }
              },
              "bridge_status": {
                "type": "string",
                "enum": ["not_applicable", "open", "partial_open"]
              },
              "physical_status": {
                "type": "string",
                "enum": ["not_established", "not_implied", "candidate", "open"]
              },
              "note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
